{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justtheconstitution",
  "main": "worker.js",
  "compatibility_date": "2026-04-29",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the contact-form API reaches the Worker; every other route is
    // served straight from static assets with no Worker invocation.
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
