# Files in this list are skipped when wrangler uploads static assets.
# See: https://developers.cloudflare.com/workers/static-assets/binding/#assetsignore

# Build-time dependencies — pulled in by `npm install` on the build container.
# Must be excluded; otherwise wrangler would try to upload tens of thousands of files.
node_modules/

# Git internals (present in the Cloudflare build container after the repo is cloned).
.git/
.gitignore
.gitattributes
.githooks/

# Build inputs — only needed at build time, not served at runtime.
build.js
index.template.html
templates/
_scripts/
package.json
package-lock.json

# Worker config — runtime config consumed by wrangler, not a static asset.
wrangler.jsonc
.wrangler/

# Repo docs and helpers not meant for visitors.
SOP.md
typography-recommendation.md
LICENSE

# Local dev / editor / other-platform artifacts.
.claude/
.netlify/
.dev.vars*
.env*
